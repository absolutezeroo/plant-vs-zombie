reliable.OnClientEvent:Connect(function(buff, inst)
	incoming_buff = buff
	incoming_inst = inst
	incoming_read = 0
	incoming_ipos = 0
	local len = buffer.len(buff)
	while incoming_read < len do
		local id = buffer.readu8(buff, read(1))
		if id == 3 then -- ZombieSpawned
			local value
			local bool_1 = buffer.readu8(incoming_buff, read(1))
			value = {  }
			value["EntityId"] = buffer.readu32(incoming_buff, read(4))
			if bit32.btest(bool_1, 0b0000000000000001) then
				value["ZombieType"] = "Basic"
			elseif bit32.btest(bool_1, 0b0000000000000010) then
				value["ZombieType"] = "Cone"
			elseif bit32.btest(bool_1, 0b0000000000000100) then
				value["ZombieType"] = "Bucket"
			elseif bit32.btest(bool_1, 0b0000000000001000) then
				value["ZombieType"] = "Pole"
			elseif bit32.btest(bool_1, 0b0000000000010000) then
				value["ZombieType"] = "Newspaper"
			elseif bit32.btest(bool_1, 0b0000000000100000) then
				value["ZombieType"] = "Football"
			elseif bit32.btest(bool_1, 0b0000000001000000) then
				value["ZombieType"] = "Imp"
			elseif bit32.btest(bool_1, 0b0000000010000000) then
				value["ZombieType"] = "Flag"
			end
			value["Lane"] = buffer.readu8(incoming_buff, read(1))
			assert(value["Lane"] >= 1, "value is less than 1!")
			assert(value["Lane"] <= 5, "value is more than 5!")
			value["PositionX"] = buffer.readf32(incoming_buff, read(4))
			if reliable_events[3][1] then
				for _, cb in reliable_events[3] do
					task.spawn(cb, value)
				end
			else
				table.insert(reliable_event_queue[3], value)
				if #reliable_event_queue[3] > 64 then
					warn(`[ZAP] {#reliable_event_queue[3]} events in queue for ZombieSpawned. Did you forget to attach a listener?`)
				end
			end
