{
  "name": "garden-swarm-lobby",
  "servePort": 34872,
  "servePlaceIds": [74774650768633],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": "Packages"
      }
    },

    "ServerScriptService": {
      "LobbyServer": {
        "$path": "src/lobby/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "LobbyClient": {
          "$path": "src/lobby/client"
        }
      }
    },

    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": true
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0.3, 0.3, 0.3],
        "Brightness": 2,
        "GlobalShadows": true,
        "Technology": "Voxel"
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
