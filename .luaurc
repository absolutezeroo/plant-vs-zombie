{
    "languageMode": "strict",
    "lint": {
        "*": true,
        "LocalUnused": "disabled",
        "FunctionUnused": "disabled",
        "ImportUnused": "disabled"
    },
    "lintErrors": false,
    "globals": [
        "game",
        "workspace",
        "script",
        "plugin",
        "shared",
        "task",
        "os",
        "utf8",
        "bit32",
        "buffer",
        "_G"
    ],
    "aliases": {
        "Packages": "Packages",
        "Shared": "src/shared",
        "ArenaServer": "src/arena/server",
        "ArenaClient": "src/arena/client",
        "LobbyServer": "src/lobby/server",
        "LobbyClient": "src/lobby/client",
        "LobbyManagers": "src/lobby/server/managers",
        "LobbyModules": "src/lobby/server/modules",
        "LobbyNetwork": "src/lobby/server/network"
    }
}
